{
  "title": "SovereignGuard Overview",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "targets": [{ "expr": "avg(rate(cpu_usage_seconds_total[5m])) by (service)" }]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "targets": [{ "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes" }]
    },
    {
      "type": "timeseries",
      "title": "P95 Latency",
      "targets": [{ "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))" }]
    },
    {
      "type": "timeseries",
      "title": "5xx Error Rate",
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (service)" }]
    }
  ]
}
